{
  "name": "slate",
  "version": "1.0.0",
  "description": "Slate: a node-graph harness for composing Python with local LLMs (VS Code webview + legacy browser notebook)",
  "scripts": {
    "clean": "rimraf dist/",
    "prebuild": "npm run clean",
    "build": "vite build",
    "start": "vite",
    "dev": "vite --open /harness.html?demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "playwright test",
    "test:electron": "npm run build && npm --prefix vscode-extension run sync-dist && npm --prefix vscode-extension run compile && npm --prefix vscode-extension run test:integration",
    "test:workbench": "npm run build && npm --prefix vscode-extension run compile && npm --prefix vscode-extension run test:workbench",
    "test:harness": "npm test && npm run test:webview && npm run test:electron && npm run test:workbench",
    "verify:baseline": "bash scripts/verify-baseline.sh",
    "package-extension": "node scripts/package-extension.js",
    "demo:llama": "bash scripts/start-llama-demo.sh",
    "legacy:dev": "node legacy/scripts/ensure-config.js && vite --config legacy/vite.config.js --open",
    "legacy:build": "node legacy/scripts/ensure-config.js && vite build --config legacy/vite.config.js",
    "legacy:test": "node legacy/scripts/ensure-config.js && vitest run --config legacy/vitest.config.js"
  },
  "keywords": [],
  "author": "Indrajeet Haldar",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^29.1.1",
    "rimraf": "^5.0.5",
    "vite": "^7.1.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@google/genai": "^1.0.0",
    "@xyflow/react": "^12.8.4",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "marked": "^11.2.0",
    "openai": "^5.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^11.1.0"
  }
}
