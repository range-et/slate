{
  "name": "slate",
  "version": "1.0.0",
  "description": "Slate: a visual node canvas for composing Python with local LLMs (VS Code custom editor + web showcase)",
  "scripts": {
    "clean": "rimraf dist/",
    "prebuild": "npm run clean",
    "build": "vite build",
    "start": "vite",
    "dev": "vite --open /harness.html?demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "playwright test",
    "test:electron": "npm run build && npm --prefix vscode-extension run sync-dist && npm --prefix vscode-extension run compile && npm --prefix vscode-extension run test:integration",
    "test:workbench": "npm run build && npm --prefix vscode-extension run sync-dist && npm --prefix vscode-extension run compile && npm --prefix vscode-extension run test:workbench",
    "test:qa": "npm run test:webview && npm run test:electron && npm run test:workbench",
    "test:harness": "npm test && npm run test:qa",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:baseline": "bash scripts/verify-baseline.sh",
    "verify:launch": "npm run verify:baseline && npm run test:qa",
    "package-extension": "node scripts/package-extension.js",
    "demo:llama": "bash scripts/start-llama-demo.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p vscode-extension/tsconfig.json --noEmit",
    "lint": "eslint src/harness vscode-extension/src --max-warnings 0",
    "verify:static": "npm run typecheck && npm run lint",
    "test:properties": "vitest run test/invariants.property.test.ts",
    "test:mutation": "stryker run",
    "test:coverage": "bash scripts/coverage-run.sh",
    "verify:coverage": "bash scripts/coverage-run.sh --check",
    "test:mutation:full-unit": "stryker run stryker.full-unit.config.json",
    "test:mutation:system": "bash scripts/system-mutation.sh"
  },
  "keywords": [],
  "author": "Indrajeet Haldar",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/instrumenter": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^29.1.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@xyflow/react": "^12.8.4",
    "codemirror": "^6.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
