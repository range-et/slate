{
  "name": "webapptemplate",
  "version": "1.0.0",
  "description": "A webapp template that I use for everything - a python/flask backend with a node based HTML/CSS/JS front end",
  "scripts": {
    "clean": "rimraf dist/",
    "ensure-config": "node scripts/ensure-config.js",
    "prebuild": "npm run ensure-config && npm run clean",
    "build": "vite build",
    "start": "vite",
    "dev": "vite --open",
    "preview": "vite preview",
    "serve": "vite preview --host"
  },
  "keywords": [],
  "author": "Indrajeet Haldar",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^5.0.5",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "marked": "^11.2.0",
    "openai": "^5.15.0",
    "uuid": "^11.1.0"
  }
}
