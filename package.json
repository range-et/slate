{
  "name": "webapptemplate",
  "version": "1.0.0",
  "description": "A webapp template that I use for everything - a python/flask backend with a node based HTML/CSS/JS front end",
  "scripts": {
    "clean": "rimraf dist/",
    "ensure-config": "node scripts/ensure-config.js",
    "prebuild": "npm run ensure-config && npm run clean",
    "build": "vite build",
    "start": "vite",
    "dev": "vite --open",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "test": "npm run ensure-config && vitest run",
    "test:watch": "npm run ensure-config && vitest",
    "setup:python-engine": "python3 -m venv .venv && .venv/bin/python -m pip install -e 'python-engine[dev]'",
    "test:python-engine": ".venv/bin/python -m pytest python-engine/tests",
    "verify:baseline": "bash scripts/verify-baseline.sh",
    "slate:roundtrip": "node scripts/slate_roundtrip.js",
    "package-extension": "node scripts/package-extension.js"
  },
  "keywords": [],
  "author": "Indrajeet Haldar",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^29.1.1",
    "rimraf": "^5.0.5",
    "vite": "^7.1.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@google/genai": "^1.0.0",
    "@xyflow/react": "^12.8.4",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "marked": "^11.2.0",
    "openai": "^5.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^11.1.0"
  }
}
