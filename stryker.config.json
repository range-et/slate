{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/harness/palette.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.js"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "ignorePatterns": [
    "**",
    "!src/**/*",
    "!test/**/*",
    "!vscode-extension/src/**/*",
    "!vscode-extension/scripts/**/*",
    "!vitest.config.js",
    "!package.json",
    "!scripts/**/*",
    "!eslint.config.mjs"
  ]
}
