{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slate.local/contracts/worker-protocol-v1.schema.json",
  "title": "Slate Python worker request v1",
  "oneOf": [
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/parseModule" },
    { "$ref": "#/$defs/adoptUnit" },
    { "$ref": "#/$defs/updateAnnotation" },
    { "$ref": "#/$defs/insertStub" },
    { "$ref": "#/$defs/replaceUnit" },
    { "$ref": "#/$defs/moveUnit" },
    { "$ref": "#/$defs/shutdown" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "protocolVersion": { "const": 1 },
        "method": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "health": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "method": { "const": "health" }, "params": { "maxProperties": 0 } },
          "unevaluatedProperties": false
        }
      ]
    },
    "parseModule": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "method": { "const": "parseModule" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {
                "source": { "type": "string" },
                "path": { "type": "string" }
              }
            }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "contract", "dependencies", "examples", "locked"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "intent": { "type": "string" },
        "contract": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "examples": { "type": "array", "items": { "type": "string" } },
        "locked": { "type": "boolean" },
        "unknown": { "type": "object" }
      }
    },
    "adoptUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "protocolVersion": { "const": 1 },
        "method": { "const": "adoptUnit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path", "expectedHash", "unitId", "annotation"],
          "properties": {
            "source": { "type": "string" },
            "path": { "type": "string" },
            "expectedHash": { "type": "string", "pattern": "^sha256:" },
            "unitId": { "type": "string" },
            "annotation": { "$ref": "#/$defs/annotation" }
          }
        }
      }
    },
    "updateAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "protocolVersion": { "const": 1 },
        "method": { "const": "updateAnnotation" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path", "expectedHash", "unitId", "annotation"],
          "properties": {
            "source": { "type": "string" },
            "path": { "type": "string" },
            "expectedHash": { "type": "string", "pattern": "^sha256:" },
            "unitId": { "type": "string" },
            "annotation": { "$ref": "#/$defs/annotation" }
          }
        }
      }
    },
    "insertStub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "protocolVersion": { "const": 1 },
        "method": { "const": "insertStub" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path", "expectedHash", "signature", "annotation"],
          "properties": {
            "source": { "type": "string" },
            "path": { "type": "string" },
            "expectedHash": { "type": "string", "pattern": "^sha256:" },
            "signature": { "type": "string" },
            "annotation": { "$ref": "#/$defs/annotation" },
            "parentId": { "type": ["string", "null"] }
          }
        }
      }
    },
    "replaceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "protocolVersion": { "const": 1 },
        "method": { "const": "replaceUnit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path", "expectedHash", "unitId", "replacement"],
          "properties": {
            "source": { "type": "string" },
            "path": { "type": "string" },
            "expectedHash": { "type": "string", "pattern": "^sha256:" },
            "unitId": { "type": "string" },
            "replacement": { "type": "string" }
          }
        }
      }
    },
    "moveUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "protocolVersion": { "const": 1 },
        "method": { "const": "moveUnit" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "sourcePath", "expectedSourceHash", "targetSource", "targetPath", "expectedTargetHash", "unitId", "annotation"],
          "properties": {
            "source": { "type": "string" },
            "sourcePath": { "type": "string" },
            "expectedSourceHash": { "type": "string", "pattern": "^sha256:" },
            "targetSource": { "type": "string" },
            "targetPath": { "type": "string" },
            "expectedTargetHash": { "type": "string", "pattern": "^sha256:" },
            "unitId": { "type": "string" },
            "annotation": { "$ref": "#/$defs/annotation" }
          }
        }
      }
    },
    "shutdown": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": { "method": { "const": "shutdown" }, "params": { "maxProperties": 0 } },
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
