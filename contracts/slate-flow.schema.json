{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slate.dev/schemas/slate-flow.schema.json",
  "title": "SlateFlow",
  "description": "Schema for a composition flow graph in Slate",
  "type": "object",
  "required": [
    "slate",
    "name"
  ],
  "properties": {
    "slate": {
      "type": "integer",
      "const": 3,
      "description": "Slate workspace format version (always 3)"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Flow name identifier"
    },
    "description": {
      "type": "string",
      "description": "Optional human description of the flow"
    },
    "inputs": {
      "type": "array",
      "description": "Flow input ports",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "annotation": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "description": "Flow output ports",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "annotation": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "instances": {
      "type": "array",
      "description": "Node or flow instances in this composition",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^.]+$"
          },
          "node": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "type": ["string", "number", "boolean", "null", "array", "object"]
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "wires": {
      "type": "array",
      "description": "Directed connections between port endpoints",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "description": "Structured regression test cases for the flow",
      "items": {
        "type": "object",
        "required": ["inputs"],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "expected": {
            "type": ["string", "number", "boolean", "null", "array", "object"]
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "regions": {
      "type": "array",
      "description": "Explicit control flow regions (branch, foreach, repeat)",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "oneOf": [
          { "properties": { "kind": { "const": "branch" } }, "required": ["thenFlow"] },
          { "properties": { "kind": { "const": "foreach" } }, "required": ["bodyFlow"] },
          { "properties": { "kind": { "const": "repeat" } }, "required": ["bodyFlow", "maxIterations"] }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^.]+$"
          },
          "kind": {
            "type": "string",
            "enum": ["branch", "foreach", "repeat"]
          },
          "label": {
            "type": "string"
          },
          "conditionPort": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "thenFlow": {
            "type": "string",
            "minLength": 1
          },
          "elseFlow": {
            "type": "string",
            "minLength": 1
          },
          "bodyFlow": {
            "type": "string",
            "minLength": 1
          },
          "collectionPort": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "itemPort": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "indexPort": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "maxIterations": {
            "type": "integer",
            "minimum": 1
          },
          "statePorts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
