{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slate.dev/schemas/slate-flow.schema.json",
  "title": "SlateFlow",
  "description": "Schema for a composition flow graph in Slate",
  "type": "object",
  "required": [
    "slate",
    "name"
  ],
  "properties": {
    "slate": {
      "type": "integer",
      "const": 3,
      "description": "Slate workspace format version (always 3)"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Flow name identifier"
    },
    "description": {
      "type": "string",
      "description": "Optional human description of the flow"
    },
    "inputs": {
      "type": "array",
      "description": "Flow input ports",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "annotation": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "description": "Flow output ports",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "annotation": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "instances": {
      "type": "array",
      "description": "Node or flow instances in this composition",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^.]+$"
          },
          "node": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "type": ["string", "number", "boolean", "null", "array", "object"]
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "wires": {
      "type": "array",
      "description": "Directed connections between port endpoints",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
