{
  "name": "slate-code",
  "displayName": "Slate Code",
  "description": "A source-linked XYFlow harness for planning, navigating, and generating typed Python units with local LLMs.",
  "version": "0.1.0",
  "publisher": "indrajeet-haldar",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Notebooks"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:slate.launcher",
    "onCustomEditor:slate.editor",
    "onCustomEditor:slate.legacyEditor",
    "onCommand:slate.openHarness"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "slate",
          "title": "Slate",
          "icon": "media/slate-icon.svg"
        }
      ]
    },
    "views": {
      "slate": [
        {
          "type": "webview",
          "id": "slate.launcher",
          "name": "Slate"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "slate.editor",
        "displayName": "Slate Python Harness",
        "selector": [
          { "filenamePattern": "*.slate.json" }
        ],
        "priority": "default"
      },
      {
        "viewType": "slate.legacyEditor",
        "displayName": "Slate Notebook (Legacy)",
        "selector": [
          { "filenamePattern": "*.slate.json" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
    { "command": "slate.openPanel", "title": "Slate: Open Legacy Panel" },
    { "command": "slate.openHarness", "title": "Slate: Open Python Harness" },
    { "command": "slate.newProject", "title": "Slate: New Project…" },
    { "command": "slate.scanWorkspace", "title": "Slate: Scan Python Workspace" },
    { "command": "slate.setupPythonEngine", "title": "Slate: Setup Python Engine" },
    { "command": "slate.checkPythonEngine", "title": "Slate: Check Python Engine" },
    { "command": "slate.compile", "title": "Slate: Compile Current Doc" },
    { "command": "slate.toggleCodeCard", "title": "Slate: Toggle Code Card" }
    ],
    "grammars": [
    {
    "scopeName": "slate.python.annotations.injection",
    "path": "./syntaxes/slate-annotations.injection.json",
    "injectTo": ["source.python"]
    }
    ],
    "configuration": {
      "title": "Slate Python Engine",
      "properties": {
        "slate.pythonEngine.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable containing slate-python-engine. Leave empty to use Slate's managed environment or a workspace .venv."
        },
        "slate.pythonEngine.bootstrapPython": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used by Slate: Setup Python Engine to create its managed environment."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node -e \"require('fs').copyFileSync('src/state-bridge.js','out/state-bridge.js')\" && node scripts/sync-python-engine.js",
    "watch": "tsc -watch -p ./",
    "sync-dist": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('../dist','dist',{recursive:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
