{
  "name": "slate-code",
  "displayName": "Slate Code",
  "description": "A source-linked XYFlow harness for planning, navigating, and generating typed Python units with local LLMs.",
  "version": "0.1.0",
  "publisher": "indrajeet-haldar",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:slate.launcher",
    "onCustomEditor:slate.editor",
    "onCommand:slate.openHarness",
    "onCommand:slate.portProject",
    "onCommand:slate.compile"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "slate",
          "title": "Slate",
          "icon": "media/slate-icon.svg"
        }
      ]
    },
    "views": {
      "slate": [
        {
          "type": "webview",
          "id": "slate.launcher",
          "name": "Slate"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "slate.editor",
        "displayName": "Slate Python Harness",
        "selector": [
          {
            "filenamePattern": "*.slate.json"
          },
          {
            "filenamePattern": "**/slate/slate.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "slate.openHarness",
        "title": "Slate: Open Python Harness"
      },
      {
        "command": "slate.newProject",
        "title": "Slate: New Project…"
      },
      {
        "command": "slate.portProject",
        "title": "Slate: Port Python Project…"
      },
      {
        "command": "slate.compile",
        "title": "Slate: Compile Project"
      },
      {
        "command": "slate.scanWorkspace",
        "title": "Slate: Scan Python Workspace"
      }
    ],
    "configuration": {
      "title": "Slate local generation",
      "properties": {
        "slate.llama.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "llama.cpp server base URL. Slate calls its OpenAI-compatible /v1/chat/completions endpoint."
        },
        "slate.llama.model": {
          "type": "string",
          "default": "local",
          "description": "Model name sent to llama.cpp. A model picker and cloud fallback are intentionally not provided."
        },
        "slate.llama.contextWindow": {
          "type": "integer",
          "default": 4096,
          "minimum": 1024
        },
        "slate.llama.outputTokens": {
          "type": "integer",
          "default": 768,
          "minimum": 64
        },
        "slate.llama.timeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 5
        }
      }
    },
    "grammars": [
      {
        "scopeName": "slate.python.annotations.injection",
        "path": "./syntaxes/slate-annotations.injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./ && node scripts/build-extension.js",
    "watch": "tsc -watch -p ./",
    "sync-dist": "node -e \"const fs=require('fs');try{if(fs.lstatSync('dist').isSymbolicLink())process.exit(0)}catch{}fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('../dist','dist',{recursive:true})\"",
    "test:integration": "node ./out/test/runTest.js",
    "test:workbench": "node ./scripts/test-workbench.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/python": "^1.1.19"
  }
}
